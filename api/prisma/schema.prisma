// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int    @id @default(autoincrement())
  name           String
  email          String @unique
  cpf            String @unique
  invitationCode String @unique
  password       String
  xp             Int    @default(0)
  capibas        Float  @default(0)

  recyclesMade RecyclesMade[]
  QuizAttempt  QuizAttempt[]

  inviterLogs InvitationLog[] @relation("UserInviterRelation")
  invitedLogs InvitationLog[] @relation("UserInvitedRelation")
  rewardLogs  RewardLog[]
}

model InvitationLog {
  id        Int   @id @default(autoincrement())
  inviterId Int
  invitedId Int
  xp        Int
  capibas   Float

  createdAt DateTime @default(now())

  inviter User @relation("UserInviterRelation", fields: [inviterId], references: [id])
  invited User @relation("UserInvitedRelation", fields: [invitedId], references: [id])

  @@unique([invitedId, inviterId])
}

model RecyclesMade {
  id       Int      @id @default(autoincrement())
  userId   Int
  doneDate DateTime

  User User @relation(fields: [userId], references: [id])
}

model Quiz {
  id        Int           @id @default(autoincrement())
  type      Int
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id           Int    @id @default(autoincrement())
  quizId       Int
  title        String
  alternatives String
  Quiz         Quiz   @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  quizId    Int
  status    Int
  createdAt DateTime @default(now())

  Quiz Quiz @relation(fields: [quizId], references: [id])
  User User @relation(fields: [userId], references: [id])
}

model RewardLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  xp        Int
  capibas   Float
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  User User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
