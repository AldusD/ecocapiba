# Database Configuration
DB_NAME=ecocapiba
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_PORT=5432
DB_HOST=localhost

# Prisma Database URL (composta pelas variáveis acima)
# Para desenvolvimento local: postgresql://user:password@localhost:5432/database
# Para Docker: postgresql://user:password@postgres:5432/database
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Node Environment
NODE_ENV=development

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_make_it_long_and_random
JWT_ACCESS_EXPIRATION=1d

# Rewards Configuration
CAPIBA_REWARD=10
XP_REWARD=50

# API Configuration
REACT_APP_API_URL=http://localhost:3001